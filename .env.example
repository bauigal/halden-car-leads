# Vehicle lookup. "mock" uses the fictional plates in src/lib/vrm/mock-provider.ts.
# "http" calls your own UK vehicle API. Both URL and key are required, and
# neither is shipped with this demo.
VRM_PROVIDER=mock
# VRM_API_BASE_URL=https://your-provider.example/lookup
# VRM_API_KEY=

# Console log of each request. On unless set to false. It includes the
# name, phone and email, so turn it off before any real enquiry.
NOTIFIER_LOG=true

# Email the buying desk via Resend. Off unless the flag is true AND the
# three values below are set. https://resend.com/docs/api-reference/emails/send-email
NOTIFIER_EMAIL=false
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Halden <valuations@example.com>"
# LEAD_NOTIFY_EMAIL=desk@example.com

# Text the buying desk via Twilio. Off unless the flag is true AND the
# four values below are set. Use E.164 numbers, for example +447700900123.
# Set TWILIO_CHANNEL=whatsapp to send on WhatsApp instead of SMS.
# https://www.twilio.com/docs/messaging/api/message-resource
NOTIFIER_SMS=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# LEAD_NOTIFY_PHONE=
# TWILIO_CHANNEL=sms
